<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
    </startup>
    <runtime>
        <!-- 线程池/后台线程未处理异常不终止进程（配合 AppDomain 崩溃日志落盘，将"闪退"变为"记录后继续"） -->
        <legacyUnhandledExceptionPolicy enabled="1" />
    </runtime>
</configuration>
